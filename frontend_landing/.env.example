# Absolute site origin used for canonical and social-share (Open Graph) URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# CloudLedger's AWS dashboard (Google OAuth, integrations, scans and reports).
NEXT_PUBLIC_APP_URL=http://localhost:5173
NEXT_PUBLIC_CAL_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
BACKEND_URL=http://127.0.0.1:8000
# Must match backend JWT_SECRET if changed from the local development default.
JWT_SECRET=smriti-local-development-secret-change-before-deployment
