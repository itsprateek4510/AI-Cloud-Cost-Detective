# Local host access; Docker Compose overrides the database and Redis hostnames.
DATABASE_URL=postgresql+psycopg://cost_detective:cost_detective@localhost:5432/cost_detective
REDIS_URL=redis://localhost:6379/0
# Replace with output from: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: leave blank to disable Gemini. Backend only; use paid-tier terms for customer data.
GEMINI_API_KEY=
# Choose a current Flash-tier model in Google AI Studio; no model is hardcoded.
GEMINI_MODEL=
# Register APP_BASE_URL/auth/google/callback in Google Cloud Console.
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# Local-only Google bypass; never enable in production. Normal Google JWTs still expire.
DEV_AUTH_ENABLED=false
AWS_REGION=us-east-1
# Optional custom JSON price table; defaults to app/aws/prices.json. Restart after editing.
# PRICE_TABLE_PATH=/absolute/path/to/prices.json

# Cost Explorer: last 3 completed months, cached 24 hours. Failures cache for 5 minutes.
COST_CACHE_TTL_SECONDS=86400
# Weekly delivery is disabled unless a channel AND explicit local user IDs are set.
DELIVERY_CHANNEL=none
DELIVERY_USER_IDS=[]
# Monday=0 ... Sunday=6; UTC. The ARQ worker must be running.
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_MINUTE=0
# Slack incoming webhook, backend only. Allowlisted users must consent to this workspace.
SLACK_WEBHOOK_URL=
# Email goes only to each allowlisted account owner's verified Google email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
